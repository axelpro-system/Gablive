# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Resend (Transactional Email) — also set as Edge Function secrets on Supabase
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Gablive <contato@axelpro.com.br>

# Shared secret for supabase/functions/send-email (header: x-email-secret)
# Set on Supabase: supabase secrets set EMAIL_FUNCTION_SECRET=...
EMAIL_FUNCTION_SECRET=change-me-long-random

# Public SPA origin for email CTA fallback (wait/room/replay).
# Prefer capturing window.location.origin at registration (already implemented).
# Do NOT set this to a marketing site (e.g. axelpro.com.br) unless the SPA is hosted there.
PUBLIC_APP_URL=https://www.gablive.com.br

# Optional: Resend Dashboard template IDs/aliases (if set, html body is ignored for that type)
# RESEND_TEMPLATE_CONFIRMATION=gablive-confirmation
# RESEND_TEMPLATE_REMINDER=gablive-reminder
# RESEND_TEMPLATE_REPLAY=gablive-replay
